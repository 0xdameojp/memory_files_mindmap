{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-files-mindmap",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // ダッシュボードで設定した環境変数 (vars) を deploy 時に消さない
  "keep_vars": true,
  "assets": {
    // 静的アセットに一致しないパスは index.html を返す (SPA)
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker で処理する
    "run_worker_first": ["/api/*"]
  }
  // 環境変数・シークレットは Cloudflare ダッシュボード
  // (Worker > Settings > Variables and Secrets) で設定する
}
